{
  "name": "encore/custom-website",
  "type": "project",
  "description": "Encore Custom Laravel website",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
