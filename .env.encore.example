# Add to .env, with the credentials provided to you by Encore. Never commit actual secrets.
ENCORE_API_URL=https://inventory.encr.co/api
ENCORE_ASSET_URL=https://encr.co/assets
ENCORE_API_KEY=
ENCORE_API_TOKEN=
ENCORE_SALES_CHANNEL_ID=1
ENCORE_INVENTORY_TYPE_ID=2
ENCORE_CURRENCY_SYMBOL="$"
ENCORE_API_TIMEOUT=15
ENCORE_API_CACHE_SECONDS=300
ENCORE_PRODUCT_DETAIL_URL=https://encr.co/productDetails

# config = names from config/clubs.php, database = active records in sport_clubs table
ENCORE_CLUBS_SOURCE=config
